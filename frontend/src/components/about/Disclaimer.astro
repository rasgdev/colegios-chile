---
export interface Props {
  lastUpdated?: string;
}

const { lastUpdated = "2025-08-01" } = Astro.props;
---

<section id="descargo" class="scroll-mt-24">
  <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
    <div class="flex items-start gap-3">
      <svg class="mt-0.5 h-6 w-6 shrink-0 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
      </svg>
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Descargo de responsabilidad</h2>
        <p class="mt-2 text-slate-700">
          Este es un proyecto de portafolio sin afiliación oficial con el MINEDUC. Los datos representan una instantánea y pueden no reflejar el estado más reciente.
        </p>
        <p class="mt-3 text-sm text-slate-500">
          Última actualización del dataset: <time datetime={lastUpdated}>{lastUpdated}</time>
        </p>
      </div>
    </div>
  </div>
</section>
