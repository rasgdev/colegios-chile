---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Acerca del proyecto",
  subtitle = "Colegios de Chile es un buscador público de establecimientos educacionales, construido sobre los datos abiertos del Sistema de Admisión Escolar (SAE) del Ministerio de Educación (MINEDUC).",
} = Astro.props;
---

<section class="border-b border-slate-200 pb-8">
  <h1 class="text-3xl font-bold text-slate-900">{title}</h1>
  <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-700">
    {subtitle}
  </p>
  <p class="mt-4 text-slate-700">
    Fuente oficial: <a
      href="https://apisae.mineduc.cl"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-brand-600 hover:underline"
    >
      apisae.mineduc.cl
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    </a>
  </p>
</section>
