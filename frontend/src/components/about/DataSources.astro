---

<section id="datos" class="scroll-mt-24">
  <h2 class="text-xl font-semibold text-slate-900">¿Qué datos incluye?</h2>
  <p class="mt-2 text-slate-600">
    El dataset abarca <strong>7.673 colegios</strong> distribuidos en <strong>344 comunas</strong> y <strong>16 regiones</strong>.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      dataItems.map((item) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <h3 class="mt-3 font-semibold text-slate-900">{item.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
