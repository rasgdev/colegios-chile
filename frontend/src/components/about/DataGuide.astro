---
interface GseLevel {
  label: string;
  colorClass: string;
  description: string;
}

interface Indicator {
  title: string;
  description: string;
  icon: string;
}

const gseLevels: GseLevel[] = [
  {
    label: "Mejor que similares",
    colorClass: "bg-green-100 text-green-700 ring-green-200",
    description: "Supera el promedio de su grupo socioeconómico.",
  },
  {
    label: "En la media",
    colorClass: "bg-slate-100 text-slate-700 ring-slate-200",
    description: "Igual al promedio de su grupo socioeconómico.",
  },
  {
    label: "Más bajo que similares",
    colorClass: "bg-red-100 text-red-700 ring-red-200",
    description: "Bajo el promedio de su grupo socioeconómico.",
  },
];

const indicators: Indicator[] = [
  {
    title: "Autoestima académica y motivación escolar",
    description:
      "Cómo el estudiante valora su capacidad de aprender y su disposición al logro académico.",
