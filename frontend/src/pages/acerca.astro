---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutHero from "../components/about/AboutHero.astro";
import DataSources from "../components/about/DataSources.astro";
import DataGuide from "../components/about/DataGuide.astro";
import Disclaimer from "../components/about/Disclaimer.astro";
import TableOfContents from "../components/about/TableOfContents.astro";

export const prerender = true;
---

<BaseLayout
  title="Acerca — Colegios de Chile"
  description="Información sobre el proyecto, el origen de los datos y cómo interpretar los indicadores del buscador de colegios."
>
  <div class="mx-auto flex w-full max-w-6xl gap-12">
    <!-- Main content -->
    <article class="min-w-0 flex-1 space-y-10">
      <AboutHero />
      <DataSources />
      <DataGuide />
      <Disclaimer />
    </article>

    <!-- Sidebar TOC (desktop only) -->
    <aside class="w-56 shrink-0">
      <TableOfContents />
    </aside>
  </div>
</BaseLayout>
