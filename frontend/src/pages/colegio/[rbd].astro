---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFicha, type FichaOut } from "../../lib/api";
import {
  copagoResumen,
  dependenciaLabel,
  etiquetaLabel,
  gseLabel,
  gseVeredict,
  indicadorDef,
  nivelEducativoLabel,
  normalizeUrl,
  regimenLabel,
  sanitizeText,
} from "../../lib/format";

const rbdRaw = Astro.params.rbd ?? "";
const rbd = Number(rbdRaw);

let ficha: FichaOut | null = null;
let error: string | null = null;

if (Number.isInteger(rbd) && rbd > 0) {
  try {
    ficha = await getFicha(rbd);
  } catch (e) {
    error = e instanceof Error ? e.message : "Error desconocido";
  }
} else {
  error = "HTTP 404";
}

if (error) {
  Astro.response.status = error.includes("404") ? 404 : 500;
}

const est = ficha?.establecimiento ?? null;

const resumen = est?.resumen_proyecto ? sanitizeText(est.resumen_proyecto) : "";
const parrafos = resumen.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);

const copago = ficha ? copagoResumen(ficha.cursos_resumen) : "Sin información";

const simce = (ficha?.indicadores ?? []).filter((i) => i.tipo_indicador === "SIMCE");
const desarrollo = (ficha?.indicadores ?? []).filter(
  (i) => i.tipo_indicador === "DESARROLLO_PERSONAL",
);

function gseBadgeClass(glosa: string | null | undefined): string {
  switch (gseVeredict(glosa)) {
    case "alto":
      return "bg-green-100 text-green-800";
    case "similar":
      return "bg-slate-100 text-slate-700";
    case "bajo":
      return "bg-red-100 text-red-700";
    default:
      return "bg-slate-100 text-slate-500";
  }
}

function gseDotClass(glosa: string | null | undefined): string {
  switch (gseVeredict(glosa)) {
    case "alto":
      return "bg-green-500";
    case "similar":
      return "bg-slate-400";
    case "bajo":
      return "bg-red-500";
    default:
      return "bg-slate-300";
  }
}

const datosClave = est
  ? [
      { k: "Niveles", v: `${est.nivel_minimo ?? "—"} a ${est.nivel_maximo ?? "—"}` },
      {
        k: "Estudiantes matriculados",
        v: est.alumnos_matriculados != null ? est.alumnos_matriculados.toLocaleString("es-CL") : "—",
      },
      {
        k: "Docentes",
        v: est.cantidad_docentes != null ? est.cantidad_docentes.toLocaleString("es-CL") : "—",
      },
      {
        k: "Prom. alumnos por curso",
        v: est.promedio_alumnos_por_curso != null ? String(est.promedio_alumnos_por_curso) : "—",
      },
      { k: "Director/a", v: est.director ?? "—" },
      { k: "Orientación religiosa", v: est.orientacion_religiosa ?? "—" },
      { k: "Política de uniforme", v: est.politica_uniforme ?? "—" },
    ]
  : [];
---

<BaseLayout
  title={est ? `${est.nombre} — Colegios de Chile` : "Colegio no encontrado"}
  description={est?.resumen_proyecto ? sanitizeText(est.resumen_proyecto).slice(0, 160) : "Ficha de establecimiento educacional"}
>
  {
    error || !est ? (
      <div class="mx-auto max-w-xl rounded-lg border border-slate-200 bg-white p-10 text-center">
        <p class="text-2xl font-semibold text-slate-900">
          {error?.includes("404") ? "Colegio no encontrado" : "Error al cargar la ficha"}
        </p>
        <p class="mt-2 text-slate-600">
          {error?.includes("404")
            ? "No existe un establecimiento con ese RBD, o el backend no está disponible."
            : "Revisa que el backend esté corriendo en el puerto 8000."}
        </p>
        <a href="/" class="mt-6 inline-block rounded-md bg-brand-600 px-4 py-2 text-white hover:bg-brand-700">
          Volver al buscador
        </a>
      </div>
    ) : (
      <article class="space-y-8">
        <nav class="text-sm text-slate-500" aria-label="Miga de pan">
          <a href="/" class="hover:text-brand-600">Inicio</a>
          <span class="mx-1">›</span>
          <a href="/" class="hover:text-brand-600">Buscar</a>
          <span class="mx-1">›</span>
          <span class="text-slate-700">{est!.nombre}</span>
        </nav>

        <header>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
              {dependenciaLabel(est!.dependencia)}
            </span>
            {est!.regimen && (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                {regimenLabel(est!.regimen)}
              </span>
            )}
          </div>
          <h1 class="mt-3 text-3xl font-bold text-slate-900">{est!.nombre}</h1>

          {est!.etiquetas.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {est!.etiquetas.map((et) => (
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">
                  {etiquetaLabel(et)}
                </span>
              ))}
            </div>
          )}
        </header>

        <section class="rounded-lg border border-brand-200 bg-brand-50 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-700">Copago</h2>
          <p class="mt-1 text-2xl font-bold text-slate-900">{copago}</p>
          <p class="mt-1 text-xs text-slate-500">
            Aporte mensual de las familias (financiamiento compartido), informado por el establecimiento.
          </p>
        </section>

        <section class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {datosClave.map((item) => (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <dt class="text-xs uppercase tracking-wide text-slate-500">{item.k}</dt>
              <dd class="mt-1 font-medium text-slate-900">{item.v}</dd>
            </div>
          ))}
        </section>

        {
          parrafos.length > 0 && (
            <section class="rounded-lg border border-slate-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-slate-900">Proyecto educativo</h2>
              {parrafos.map((p) => (
                <p class="mt-3 whitespace-pre-line text-slate-700">{p}</p>
              ))}
            </section>
          )
        }

        {
          ficha!.sedes.length > 0 && (
            <section class="rounded-lg border border-slate-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-slate-900">Sedes</h2>
              <ul class="mt-3 space-y-3">
                {ficha!.sedes.map((sede) => (
                  <li class="rounded-md bg-slate-50 p-3 text-sm text-slate-700">
                    <p class="font-medium text-slate-900">{sede.comuna}, {sede.region}</p>
                    {sede.calle && <p class="mt-1">{sede.calle}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          ficha!.indicadores.length > 0 && (
            <section class="rounded-lg border border-slate-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-slate-900">Indicadores</h2>
              <p class="mt-1 text-xs text-slate-500">
                El color compara a este colegio con otros de su mismo grupo socioeconómico, no con
                el puntaje nacional.{" "}
                <a href="/acerca#indicadores" class="text-brand-600 hover:underline">¿Cómo entender estos datos?</a>
              </p>

              {simce.length > 0 && (
                <div class="mt-4">
                  <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">SIMCE</h3>
                  <ul class="mt-2 divide-y divide-slate-100">
                    {simce.map((ind) => (
                      <li class="flex items-center justify-between gap-4 py-3">
                        <div>
                          <p class="font-medium text-slate-900" title={indicadorDef(ind.nombre_indicador)}>
                            {ind.nombre_indicador}
                            {ind.nivel_indicador && (
                              <span class="ml-1 text-xs font-normal text-slate-500">
                                · {nivelEducativoLabel(ind.nivel_indicador)}
                              </span>
                            )}
                          </p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                          <span class="text-lg font-semibold text-slate-900">{ind.puntaje ?? "—"}</span>
                          <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${gseBadgeClass(ind.comparacion_gse_glosa)}`}>
                            <span class={`h-1.5 w-1.5 rounded-full ${gseDotClass(ind.comparacion_gse_glosa)}`}></span>
                            {gseLabel(ind.comparacion_gse_glosa)}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {desarrollo.length > 0 && (
                <div class="mt-4">
                  <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Desarrollo personal</h3>
                  <ul class="mt-2 divide-y divide-slate-100">
                    {desarrollo.map((ind) => (
                      <li class="flex items-center justify-between gap-4 py-3">
                        <div>
                          <p class="font-medium text-slate-900" title={indicadorDef(ind.nombre_indicador)}>
                            {ind.nombre_indicador}
                            {ind.nivel_indicador && (
                              <span class="ml-1 text-xs font-normal text-slate-500">
                                · {nivelEducativoLabel(ind.nivel_indicador)}
                              </span>
                            )}
                          </p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                          <span class="text-lg font-semibold text-slate-900">{ind.puntaje ?? "—"}</span>
                          <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${gseBadgeClass(ind.comparacion_gse_glosa)}`}>
                            <span class={`h-1.5 w-1.5 rounded-full ${gseDotClass(ind.comparacion_gse_glosa)}`}></span>
                            {gseLabel(ind.comparacion_gse_glosa)}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )
        }

        {
          ficha!.actividades.length > 0 && (
            <section class="rounded-lg border border-slate-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-slate-900">Actividades</h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {ficha!.actividades.map((a) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                    {a.nombre}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (est!.telefono || est!.mail || est!.url) && (
            <section class="rounded-lg border border-slate-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-slate-900">Contacto</h2>
              <ul class="mt-2 space-y-1 text-sm text-slate-700">
                {est!.telefono && <li>Teléfono: {est!.telefono}</li>}
                {est!.mail && <li>Email: {est!.mail}</li>}
                {est!.url && (
                  <li>
                    Sitio web:{" "}
                    <a href={normalizeUrl(est!.url)} target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">{est!.url}</a>
                  </li>
                )}
              </ul>
            </section>
          )
        }

        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 hover:text-brand-700"
        >
          ← Volver al buscador
        </a>
      </article>
    )
  }
</BaseLayout>
