# =============================================
# CONFIGURACIÓN DEL PROYECTO COLEGIOS CHILE
# =============================================
# Copia este archivo a .env y completa los valores.
# NO commitear .env con passwords reales.

# ── Entorno ────────────────────────────────
# development | production
ENVIRONMENT=development

# ── API Externas ───────────────────────────
API_BASE_URL=https://apisae.mineduc.cl
COMUNAS_API_URL=https://api.baseapi.cl/api/v1/sii/datos/comunas

# ── Scraping ───────────────────────────────
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=5
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ── Rutas ──────────────────────────────────
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
LOGS_DIR=logs
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# ── Backend / Persistencia ─────────────────
# En production, usar password real via variable ${DB_PASSWORD} (substituido por startup.sh)
DATABASE_URL=postgresql+asyncpg://colegios:colegios@localhost:5432/colegios
API_PORT=8000
FRONTEND_PORT=4321
# Orígenes CORS (CSV). Vacío → dev usa localhost:4321; prod sin cabeceras CORS (same-origin vía nginx).
# CORS_ORIGINS=https://TU_IP_O_DOMINIO
